# LibraryApp server test environment template
# Copy to .env.test or export TEST_DATABASE_URL before running pytest.
# Use a disposable PostgreSQL database only.

TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:15432/libraryapp_test
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/test

# The test harness copies TEST_DATABASE_URL into DATABASE_URL before importing the app.
# The database name must contain "test"; this prevents accidental destructive runs.
