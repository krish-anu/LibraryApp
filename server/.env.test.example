# LibraryApp server test environment template
# Copy to .env.test or export TEST_DATABASE_URL before running pytest.
# Use a disposable PostgreSQL database only.

TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:15432/libraryapp_test
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/test
ASGARDEO_PUBLIC_CLIENT_ID=
ASGARDEO_INTROSPECTION_CLIENT_ID=
ASGARDEO_INTROSPECTION_CLIENT_SECRET=
ASGARDEO_SCOPE="openid profile email groups roles dashboard_read books_read books_manage content_read content_manage categories_read categories_manage loans_read loans_manage reservations_read reservations_manage favorites_read favorites_manage users_read users_manage fines_read fines_manage notifications_read notifications_manage settings_read settings_manage"
ADMIN_EMAILS=
ADMIN_SUBJECTS=

# The test harness copies TEST_DATABASE_URL into DATABASE_URL before importing the app.
# The database name must contain "test"; this prevents accidental destructive runs.

# Required only for `make test-server-live-auth` / `make test-server-complete`.
# These may also live in admin/.env.e2e.local.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_SUBJECT=
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
